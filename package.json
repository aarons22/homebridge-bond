{
  "name": "homebridge-bond",
  "version": "3.4.0-beta.1",
  "description": "A homebridge plugin to control your Bond devices over the v2 API.",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts tools/bond-simulator/*.ts",
    "simulator": "ts-node tools/bond-simulator/cli.ts",
    "watch": "npm run build && npm link && nodemon",
    "dev": "tsc --watch & nodemon dist",
    "build": "rimraf ./dist && tsc -p tsconfig-build.json",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "mocha -r ts-node/register 'tests/**/*.spec.ts'",
    "coverage": "nyc -r lcov -e .ts -x \"*.spec.ts\" npm run test"
  },
  "keywords": [
    "homebridge-plugin",
    "bond",
    "bond-home",
    "rf",
    "ir"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/aarons22/homebridge-bond.git"
  },
  "bugs": {
    "url": "http://github.com/aarons22/homebridge-bond/issues"
  },
  "engines": {
    "node": "^18.20.4 || ^20.15.1 || ^22 || ^24",
    "homebridge": "^1.6.0 || ^2.0.0-beta.0"
  },
  "devDependencies": {
    "@types/chai": "^4.2.14",
    "@types/flake-idgen": "^0.1.30",
    "@types/mocha": "^10.0.10",
    "@types/nock": "^10.0.3",
    "@types/node": "^20.0.0",
    "@types/sinon": "^21.0.1",
    "@typescript-eslint/eslint-plugin": "^4.18.0",
    "@typescript-eslint/parser": "^4.18.0",
    "chai": "^4.2.0",
    "eslint": "^7.22.0",
    "homebridge": "^2.0.0-beta.68",
    "mocha": "^11.7.6",
    "nock": "^14.0.15",
    "nodemon": "^3.1.7",
    "nyc": "^15.1.0",
    "rimraf": "^3.0.2",
    "sinon": "^22.0.0",
    "ts-node": "^10.8.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "axios": "1.16.1",
    "axios-retry": "4.5.0",
    "biguint-format": "^1.0.2",
    "flake-idgen": "^1.4.0"
  },
  "overrides": {
    "serialize-javascript@<7.0.5": "^7.0.5",
    "uuid@<11.1.1": "^11.1.1",
    "picomatch@<2.3.2": "^2.3.2",
    "flatted@<3.4.2": "^3.4.2",
    "minimatch@<3.1.3": "^3.1.3",
    "minimatch@4.0.0 - 4.2.4": "^4.2.5",
    "js-yaml@<3.14.2": "^3.14.2",
    "js-yaml@4.0.0 - 4.1.0": "^4.1.1"
  },
  "homepage": "https://github.com/aarons22/homebridge-bond#readme",
  "author": "Aaron Sapp"
}
